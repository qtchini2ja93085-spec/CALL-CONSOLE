{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CALLCONSOLE",
  "version": "1.0.0",
  "identifier": "com.epmsolutions.callconsole",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CALLCONSOLE",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "../resources/icons/icon-192.png",
      "../resources/icons/icon-512.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "CALLCONSOLE"
      }
    }
  }
}
